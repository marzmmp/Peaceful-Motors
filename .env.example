# ============================================================
# Peaceful OS — environment variables
# Copy to .env.local for local dev. In production set these in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit the filled-in version. .gitignore covers it.
# ============================================================

# ---------- REQUIRED: database + auth ----------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SERVER ONLY. No NEXT_PUBLIC_ prefix, on purpose — that prefix is what
# would bundle it into the browser. This key bypasses every RLS policy.
# Used only for rate limiting and phone verification.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- REQUIRED: photo analysis and diagnostics ----------
# console.anthropic.com — set a monthly spend cap while you're there.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-4-6. claude-sonnet-5 is the current
# generation if you want to move up.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- OPTIONAL: email (resend.com, free tier) ----------
RESEND_API_KEY=re_...
EMAIL_FROM="Peaceful Motors <service@peacefulmotors.com>"
# Archive copy of every customer email. This replaced a hardcoded address
# in the old code — leaving it hardcoded meant every future shop's
# customer mail would copy to one personal inbox.
SHOP_INBOX=peacefulmotors@outlook.com
EMAIL_BRAND_NAME="Peaceful Motors, LLC"

# ---------- OPTIONAL: texting (twilio.com) ----------
# U.S. business texting also needs A2P 10DLC brand + campaign registration.
# Approval takes days. Buy the number first, register, then texts flow.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+13145550123

# ---------- NOT YET AVAILABLE (routes are plumbing until these exist) ----------
PARTSTECH_ACCOUNT=
PARTSTECH_API_KEY=
REPAIRLINK_USER=
REPAIRLINK_API_KEY=
CARFAX_PARTNER_KEY=
